local bound = require("./LegacyTick")  -- the exported bound table (what TickAPI.Tick is)
local function falseKeys(t) local n = 0 for k, v in pairs(t) do if v == false then n += 1 end end return n end
print("=== 7: colon-vs-dot on the bound table ===")
local h = bound.delay(function() print("  h fired") end, 0.5)
print("  bound.getClocks()  ->", pcall(function() return bound.getClocks() end))
print("  bound:getClocks()  ->", pcall(function() return bound:getClocks() end), "(real count is 1)")
print("  bound:remove(h)    ->", pcall(function() return bound:remove(h) end), " event still scheduled? #hidden-group unknown; false-key on bound:", falseKeys(bound), " bound[bound]=", bound[bound])
bound.update(1)  -- h fires => it was NOT removed by bound:remove(h)
print("  bound:delay(fn,1)  ->", pcall(function() return bound:delay(function() end, 1) end))
print("  bound:recur(fn,1)  ->", pcall(function() return bound:recur(function() end, 1) end))
print("  bound:event(fn,1)  ->", pcall(function() return bound:event(function() end, 1, false) end))
print("  bound.event(fn,1)  ->", pcall(function() return bound.event(function() end, 1, false) end))
print("  bound:update(0.1)  ->", pcall(function() return bound:update(0.1) end), "(silently no-op on the empty bound table)")
local e2 = setmetatable({timer = 1, delay = 1, fn = function() end}, {})
print("  bound:add(e)       ->", pcall(function() return bound:add(e2) end), " #bound =", #bound, "(added to the bound table, never updated)")
print("  bound:group()      ->", pcall(function() return type(bound:group()) end))
print("  bound.remove(h)    -> (dot form, correct) ", pcall(function() return bound.remove(h) end))
local h2 = bound.delay(function() end, 1)
print("  h2.stop()  (dot)   ->", pcall(function() return h2.stop() end))
print("  h2.reset() (dot)   ->", pcall(function() return h2.reset() end))
print("  h2.adjust(2) (dot) ->", pcall(function() return h2.adjust(2) end))
print("  h2.after(fn,1)(dot)->", pcall(function() return h2.after(function() end, 1) end))
